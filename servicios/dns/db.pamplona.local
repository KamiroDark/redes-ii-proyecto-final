$TTL 3600
@   IN  SOA dns1.pamplona.local. admin.pamplona.local. (
        2026111901  ; Serial (AAAAMMDDNN, subir al editar)
        3600        ; Refresh
        900         ; Retry
        604800      ; Expire
        3600 )      ; Negative cache TTL

@       IN  NS      dns1.pamplona.local.

; Servidores
dns1    IN  A       192.168.20.3
dhcp    IN  A       192.168.10.2
web     IN  A       192.168.30.2
www     IN  CNAME   web

; Equipos de red
r1      IN  A       20.20.20.1
r2      IN  A       20.20.20.2
s3      IN  A       192.168.15.1
